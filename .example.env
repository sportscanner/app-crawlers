API_BASE_URL=http://localhost:8000/
CLOUD_FIRESTORE_CREDENTIALS_PATH=/path/to/sportscanner-firebase-adminsdk.json
CLOUD_FIRESTORE_PROJECT_ID=dummy-project-id
DB_CONNECTION_STRING="postgresql://user:password@localhost:5432/dbname?sslmode=require"
ENV=dev
FIRESTORE_USER_COLLECTION=users.collection
HTTPX_CLIENT_MAX_CONNECTIONS=100
HTTPX_CLIENT_MAX_KEEPALIVE_CONNECTIONS=10
HTTPX_CLIENT_TIMEOUT=10.0
JWT_ALGORITHM=HS256
JWT_SECRET=dummy-jwt-secret
KINDE_CLIENT_ID=dummy-client-id
KINDE_DOMAIN=https://auth.example.com
OPENAI_API_KEY=sk-example
# Optional alias used by some OpenAI-compatible Azure setups:
# AZURE_OPENAI_API_KEY=sk-example
# SPORTSCANNER_AGENT_API_KEY=sk-example
OPENAI_BASE_URL=https://api.openai.com/v1
PHOENIX_API_KEY=phoenix-api-key
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
# If your Phoenix Cloud instance requires API key headers, uncomment:
# PHOENIX_CLIENT_HEADERS=api_key=<phoenix-api-key>
PHOENIX_PROJECT_NAME=sportscanner-backend
PHOENIX_AUTO_INSTRUMENT=True
ROTATING_PROXY_ENDPOINT=http://user:password@proxy.example.com:8080/
SQL_DATABASE_NAME=exampledb
SPORTSCANNER_AGENT_MODEL=openai/gpt-4.1-mini
SPORTSCANNER_MCP_SERVER_URL=http://127.0.0.1:8000/mcp/
USE_PROXIES=False
